# ─── Mode switches ────────────────────────────────────────────────────────
# The local demo needs none of the AWS values below.
DEMO_MODE=true
BLOCKCHAIN_MODE=local          # local | fabric
DATA_MODE=local                # local | dynamodb
POLICY_MODE=local              # local (Cedar WASM) | avp (Amazon Verified Permissions)
AGENT_MODE=local               # local | strands
AUTH_MODE=demo                 # demo | cognito
EVIDENCE_MODE=local            # local | s3

# ─── Secrets (required when DEMO_MODE=false) ─────────────────────────────
SESSION_SECRET=
WALLET_ENCRYPTION_KEY=

# ─── AWS ─────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DYNAMODB_TABLE=trustline
S3_BUCKET=
VERIFIED_PERMISSIONS_POLICY_STORE=
BEDROCK_MODEL_ID=
STRANDS_AGENT_URL=
STRANDS_AGENT_TOKEN=
AVP_POLICY_MAP=                # printed by scripts/upload-avp.sh

# ─── Hyperledger Fabric / Amazon Managed Blockchain ──────────────────────
FABRIC_PEER_ENDPOINT=
FABRIC_PEER_HOST_ALIAS=
FABRIC_TLS_CERT_PATH=
FABRIC_MSP_ID=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_CHANNEL=trustline
FABRIC_CHAINCODE=trustline
